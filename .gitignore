# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files — these hold live credentials, never commit them.
# The negation keeps the placeholder template tracked.
.env
.env.*
!.env.example

# Cloudflare Worker local secrets and build state. Production secrets live in
# Cloudflare (`wrangler secret put`), never in the repo.
worker/.dev.vars
worker/.dev.vars.*
!worker/.dev.vars.example
worker/.wrangler

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
