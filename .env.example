# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is gitignored. This template is committed, so it must only ever
# contain placeholders — never paste a real secret into this file.
#
# Vite only exposes variables prefixed with VITE_, and it INLINES them into the
# built JavaScript. Everything here is readable by anyone who loads the site.
#
# THE RULE: if a value must stay secret, it does not get a VITE_ prefix and it
# does not live in this file. The Airtable token and the admin password are
# secrets — they live in the Cloudflare Worker (see worker/.dev.vars.example).
# Airtable is still the database; the Worker is just what talks to it.
#
# Vite reads .env once at startup — restart `npm run dev` after any change.
# ---------------------------------------------------------------------------

# --- API ------------------------------------------------------------------
# The Cloudflare Worker that fronts Airtable. Public by design: it is only a
# URL, and every route that matters is authenticated inside the Worker.
#   local:      http://127.0.0.1:8787   (npm run dev --prefix worker)
#   production: https://igem-gallery-api.<your-subdomain>.workers.dev
VITE_API_URL=http://127.0.0.1:8787

# --- Cloudinary -----------------------------------------------------------
# Uploads go straight from the browser to Cloudinary using an UNSIGNED preset.
# Both values below are public by design — the preset grants upload-only
# access, never read or delete. Enforce the real limits (max file size, allowed
# formats, folder) in the Cloudinary dashboard, not here.

# Dashboard → "Cloud name" (Product Environment). Not your account email.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Settings → Upload → Upload presets → the preset you created, Signing = Unsigned.
VITE_CLOUDINARY_UPLOAD_PRESET=igem_games
