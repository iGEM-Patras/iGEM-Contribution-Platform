# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is gitignored. This template is committed, so it must only ever
# contain placeholders — never paste a real token into this file.
#
# Vite only exposes variables prefixed with VITE_, and it INLINES them into
# the built JavaScript. Anything here is readable by anyone who loads the
# deployed site. See the deployment note in README.md before pushing.
#
# Vite reads .env once at startup — restart `npm run dev` after any change.
# ---------------------------------------------------------------------------

# --- Airtable -------------------------------------------------------------
# Personal access token: https://airtable.com/create/tokens
# Scopes required: data.records:write
# Access required:  the "iGEM Game Gallery Beta" base
# Starts with "pat".
VITE_AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base ID — open https://airtable.com/api, pick your base; the ID starts "app".
# Also visible in the base URL: airtable.com/appXXXXXXXXXXXXXX/tblYYYYYYYYYYYYYY
VITE_AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Table ID (starts "tbl") — the second path segment of that same URL.
# The table NAME also works, but the ID survives renaming the table.
VITE_AIRTABLE_TABLE_ID=tblYYYYYYYYYYYYYY

# --- Cloudinary -----------------------------------------------------------
# Dashboard → "Cloud name" (Product Environment). Not your account email.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Settings → Upload → Upload presets → the preset you created, Signing = Unsigned.
VITE_CLOUDINARY_UPLOAD_PRESET=igem_games
